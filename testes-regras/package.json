{
  "name": "fenix-testes-regras",
  "version": "5.4.0",
  "private": true,
  "description": "Testes das regras de segurança do Firestore da biblioteca Fênix (emulador local, sem tocar no banco real)",
  "type": "module",
  "scripts": {
    "pretest": "node --input-type=module -e \"import fs from 'fs'; fs.copyFileSync('../firestore.rules','firestore.rules')\"",
    "test": "firebase emulators:exec --only firestore --project demo-fenix \"node --test teste-regras.mjs\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "firebase": "^10.12.2",
    "firebase-tools": "^13.0.0"
  }
}
